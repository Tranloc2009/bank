# PORT: Cổng chạy ứng dụng (mặc định 3000; các nền tảng miễn phí như Render/HF Spaces tự cấp biến này)
PORT="3000"

# PLAYBANK_DB_PATH: Đường dẫn tệp SQLite mặc định khi chạy cục bộ hoặc không dùng DATABASE_URL.
PLAYBANK_DB_PATH="./playbank.db"

# DATABASE_URL (Tùy chọn - MIỄN PHÍ không cần thẻ):
# Dán chuỗi kết nối PostgreSQL miễn phí từ Neon.tech hoặc Supabase.com khi triển khai lên Render Free / Hugging Face Spaces.
# Khi bỏ trống, hệ thống tự dùng SQLite cục bộ tại PLAYBANK_DB_PATH.
# DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
